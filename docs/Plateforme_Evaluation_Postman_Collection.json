    },
    {
      "name": "04 - Résultats de l'étudiant (DS-13)",
      "description": "Lecture seule. Aucune note avant la publication par l'enseignant ; bonnes réponses des QCM après la fermeture + 2 min ; cas de test masqués réduits à leur verdict ; moyenne de la promotion à partir de 5 copies notées.",
      "item": [
        {
          "name": "4.1 Résultats d'une copie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 avec un état connu', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(['NON_REMISE', 'EN_ATTENTE', 'PUBLIES']).to.include(pm.response.json().etat);",
                  "});",
                  "pm.test('Aucune note tant que les résultats ne sont pas publiés', () => {",
                  "    const r = pm.response.json();",
                  "    if (r.etat !== 'PUBLIES') {",
                  "        pm.expect(r.noteFinale).to.equal(null);",
                  "        pm.expect(r.questions).to.be.empty;",
                  "    }",
                  "});",
                  "pm.test('Moyenne seulement avec l\\'écart, jamais de rang', () => {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r).to.not.have.property('rang');",
                  "    if (r.moyennePromotion === null) pm.expect(r.ecartMoyenne).to.equal(null);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}/resultats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soumissions",
                "{{soumissionId}}",
                "resultats"
              ]
            },
            "description": "etat : NON_REMISE (copie en cours, renvoi vers l'épreuve), EN_ATTENTE (remise, résultats non publiés : aucune note) ou PUBLIES (note, moyenne, ecartMoyenne, corrigeVisible, détail par question). 403 pour la copie d'un autre étudiant, ou pour un autre rôle qu'étudiant.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "4.2 Mon tableau de bord (performances)",
