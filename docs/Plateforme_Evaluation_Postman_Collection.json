{
  "info": {
    "name": "Plateforme d'Évaluation EPT — API Collection",
    "_postman_id": "c1f7b889-8d54-4362-9e90-eval-ept-2026",
    "description": "Collection des endpoints de la Plateforme d'Évaluation EPT (DIC1-GIT), avec authentification JWT automatique.\nDiagrammes de séquence couverts : DS-01 et DS-02 (passation et remise), DS-10 (liste et démarrage), DS-12 (épreuve de code corrigée par Judge0), DS-13 (résultats), DS-14 (connexion, /auth/me).\nChaque login range son jeton : {{token}} (étudiant, utilisé par les dossiers 02 à 04), {{tokenEnseignant}}, {{tokenAdmin}}. La collection se joue d'un bout à l'autre sur une base neuve (profil h2-dev), comme en CI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "soumissionId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "evaluationId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "versionReponses",
      "value": "0",
      "type": "string"
    },
    {
      "key": "codeEvaluationId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "soumissionCodeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "questionCodeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "versionCode",
      "value": "0",
      "type": "string"
    },
    {
      "key": "tokenEnseignant",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Authentification",
      "description": "Connexion des différents rôles avec récupération automatique du Bearer Token JWT.",
      "item": [
        {
          "name": "1.1 Login Étudiant (Aminou Niang)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : jeton étudiant', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().token).to.be.a('string');",
                  "    pm.expect(pm.response.json().role).to.equal('ETUDIANT');",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"etudiant@ept.sn\",\n  \"motDePasse\": \"etudiant123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "1.2 Login Enseignant (Mamadou Sow)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : jeton enseignant', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().token).to.be.a('string');",
                  "    pm.expect(pm.response.json().role).to.equal('ENSEIGNANT');",
                  "});",
                  "pm.collectionVariables.set('tokenEnseignant', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prof@ept.sn\",\n  \"motDePasse\": \"prof123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "1.3 Login Administrateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : jeton administrateur', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().token).to.be.a('string');",
                  "    pm.expect(pm.response.json().role).to.equal('ADMIN');",
                  "});",
                  "pm.collectionVariables.set('tokenAdmin', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ept.sn\",\n  \"motDePasse\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "1.4 Profil de l'utilisateur connecté (/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : profil de l\\'utilisateur du jeton', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const u = pm.response.json();",
                  "    pm.expect(u.email).to.be.a('string');",
                  "    pm.expect(['ETUDIANT', 'ENSEIGNANT', 'ADMIN']).to.include(u.role);",
                  "    pm.expect(u.token).to.equal(null); // le jeton n'est jamais renvoyé ici",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Revalide la session au démarrage du front (DS-14) : l'utilisateur gardé dans le navigateur n'est qu'un cache. 401 NON_AUTHENTIFIE si le jeton est absent, invalide ou expiré, ou si le compte a été désactivé.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "1.5 Mon profil (lecture seule)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 : identité, matricule et promotion de l'étudiant, sans mot de passe\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    const p = pm.response.json();",
                  "    pm.expect(p.role).to.equal('ETUDIANT');",
                  "    pm.expect(p.numEtudiant).to.be.a('string');",
                  "    pm.expect(p.promotion).to.be.a('string');",
                  "    pm.expect(p).to.not.have.property('motDePasse');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/profil",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profil"
              ]
            },
            "description": "Profil de l'utilisateur connecté, tous rôles. Identité en lecture seule : elle est gérée par l'administrateur. numEtudiant et promotion pour un étudiant seulement.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "1.6 Changer son mot de passe : mot de passe actuel faux",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 (pas 401, qui déconnecterait le front) avec un message', () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().detail).to.include('actuel');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motDePasseActuel\": \"pas-le-bon\",\n  \"nouveauMotDePasse\": \"nouveauMotDePasse\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profil/mot-de-passe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profil",
                "mot-de-passe"
              ]
            },
            "description": "Changement de son mot de passe : 204 si le mot de passe actuel est bon. Nouveau : 8 caractères au moins, 72 octets au plus (BCrypt), différent de l'actuel. Les échecs comptent avec ceux de la connexion : 429 après 5 échecs en 15 min.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Passation & Soumission (DS-01, DS-02, DS-10)",
      "description": "Endpoints de gestion d'une copie d'examen, de l'auto-save toutes les 30s et de la soumission finale.",
      "item": [
        {
          "name": "2.0 DS-10: Mes évaluations (étudiant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var liste = pm.response.json();",
                  "pm.test('200 : liste des évaluations', function () { pm.response.to.have.status(200); });",
                  "var ouverte = function (e) { return e.statut === 'EN_COURS' || e.statut === 'PUBLIEE'; };",
                  "// Le dossier 02 envoie des réponses QCM : il lui faut une évaluation 100 % QCM (la liste est triée",
                  "// par date d'ouverture, la première n'est pas forcément un QCM). Le dossier 03 prend l'évaluation de code.",
                  "var qcm = liste.find(function (e) { return ouverte(e) && e.typesQuestions.length === 1 && e.typesQuestions[0] === 'QCM'; });",
                  "var code = liste.find(function (e) { return ouverte(e) && e.typesQuestions.indexOf('CODE') !== -1; });",
                  "if (qcm) { pm.collectionVariables.set('evaluationId', qcm.id); console.log('Évaluation QCM : ' + qcm.id); }",
                  "if (code) { pm.collectionVariables.set('codeEvaluationId', code.id); console.log('Évaluation de code : ' + code.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/etudiant/evaluations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "etudiant",
                "evaluations"
              ]
            },
            "description": "Évaluations publiées, en cours ou terminées de la promotion de l'étudiant, avec durée effective (tiers-temps), types de questions et état de sa copie. Retient l'évaluation QCM (evaluationId, dossier 02) et l'évaluation de code (codeEvaluationId, dossier 03)."
          }
        },
        {
          "name": "2.1 Démarrer ou Reprendre l'épreuve",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('soumissionId', jsonData.id);",
                  "    console.log('Soumission ID enregistrée: ' + jsonData.id);",
                  "}",
                  "if (jsonData.versionReponses !== undefined) {",
                  "    pm.collectionVariables.set('versionReponses', jsonData.versionReponses);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/soumissions/evaluations/{{evaluationId}}/demarrer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soumissions",
                "evaluations",
                "{{evaluationId}}",
                "demarrer"
              ]
            },
            "description": "Crée la copie ou reprend celle qui existe. Copie expirée : clôturée et renvoyée avec le statut SOUMIS. Copie remise : statut seul, sans questions. Retient soumissionId et versionReponses."
          }
        },
        {
          "name": "2.2 Consulter le Sujet et l'état de la Copie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : copie encore en cours', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('soumissionId')));",
                  "    pm.expect(pm.response.json().statut).to.equal('EN_COURS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soumissions",
                "{{soumissionId}}"
              ]
            }
          }
        },
        {
          "name": "2.3 DS-02: Auto-save des Réponses (toutes les 30s)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reponses\": [\n    {\n      \"questionId\": 1,\n      \"choixIds\": [\n        2\n      ]\n    },\n    {\n      \"questionId\": 2,\n      \"choixIds\": [\n        5,\n        7,\n        8\n      ]\n    }\n  ],\n  \"versionAttendue\": {{versionReponses}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}/sauvegarder",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soumissions",
                "{{soumissionId}}",
                "sauvegarder"
              ]
            },
            "description": "versionAttendue = version des réponses sur laquelle le client a saisi (facultative). Si la copie a été enregistrée entre-temps ailleurs : 409 VERSION_OBSOLETE avec versionActuelle."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : sauvegarde acceptée, nouvelle version', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().versionReponses).to.be.above(Number(pm.collectionVariables.get('versionReponses')));",
                  "    pm.expect(pm.response.json().dateSauvegarde).to.be.a('string');",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.versionReponses !== undefined) {",
                  "    pm.collectionVariables.set('versionReponses', jsonData.versionReponses);",
                  "} else if (jsonData.versionActuelle !== undefined) {",
                  "    pm.collectionVariables.set('versionReponses', jsonData.versionActuelle);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.4 Anti-Triche: Signaler Changement d'Onglet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : sortie comptée par le serveur', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().nbChangementsOnglet).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}/changement-onglet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soumissions",
                "{{soumissionId}}",
                "changement-onglet"
              ]
            }
          }
        },
        {
          "name": "2.5 DS-01: Soumission Finale de la Copie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : copie remise', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().statut).to.equal('SOUMIS');",
                  "    pm.expect(pm.response.json().dateRemise).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}/soumettre",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soumissions",
                "{{soumissionId}}",
                "soumettre"
              ]
            }
          }
        },
        {
          "name": "2.6 Quiz : passer à la question suivante",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test('200 : copie sur sa question en cours', () => {",
                  "        pm.expect(pm.response.json().quiz).to.be.an('object');",
                  "    });",
                  "} else {",
                  "    pm.test('Refus au format RFC 7807 avec un code', () => {",
                  "        pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "        pm.expect(pm.response.json().code).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}/quiz/suivante",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soumissions",
                "{{soumissionId}}",
                "quiz",
                "suivante"
              ]
            },
            "description": "Quiz chronométré (V5) : l'ordre et le temps des questions sont imposés par le serveur. N'avance que si la copie est encore sur `indexActuel` (un double clic n'avance pas deux fois) et renvoie la copie sur sa question en cours, avec `quiz` (indexQuestion, nbQuestions, dureeQuestion, tempsRestantQuestionSecondes). Les données de démonstration ne contiennent pas de quiz : sur la copie QCM, la requête est refusée.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"indexActuel\": 0\n}"
            }
          }
        }
      ]
    },
    {
      "name": "03 - Épreuve de code (DS-12)",
      "description": "Copie de l'évaluation de code de démonstration (codeEvaluationId = 2). Le langage est enregistré avec la réponse (V6) ; la remise déclenche la correction automatique par Judge0 (DS-12). Sans Judge0 joignable, la copie reste SOUMIS et la correction est retentée 1, 2, 4 puis 8 min plus tard, puis passe en correction manuelle. Un exercice de code est un programme complet : entrée du cas de test sur l'entrée standard, sortie standard comparée à la sortie attendue. À lancer après 2.0 (qui retient codeEvaluationId) et sur une base neuve, comme le dossier 02 : une copie remise ne peut plus être modifiée.",
      "item": [
        {
          "name": "3.1 Démarrer l'épreuve de code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : copie et question de code', () => pm.response.to.have.status(200));",
                  "const copie = pm.response.json();",
                  "pm.collectionVariables.set('soumissionCodeId', copie.id);",
                  "if (copie.versionReponses !== undefined) pm.collectionVariables.set('versionCode', copie.versionReponses);",
                  "if (copie.questions && copie.questions.length) pm.collectionVariables.set('questionCodeId', copie.questions[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/soumissions/evaluations/{{codeEvaluationId}}/demarrer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soumissions",
                "evaluations",
                "{{codeEvaluationId}}",
                "demarrer"
              ]
            },
            "description": "Retient la copie (soumissionCodeId), la question (questionCodeId) et la version des réponses (versionCode).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "3.2 Sauvegarder le code (avec son langage)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : sauvegarde acceptée', () => pm.response.to.have.status(200));",
                  "if (pm.response.json().versionReponses !== undefined) {",
                  "    pm.collectionVariables.set('versionCode', pm.response.json().versionReponses);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
