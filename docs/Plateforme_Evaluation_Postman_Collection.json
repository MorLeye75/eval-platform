            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 : historique cohérent', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const p = pm.response.json();",
                  "    pm.expect(p.historique).to.be.an('array');",
                  "    pm.expect(p.nbEvaluations).to.equal(p.historique.length);",
                  "    if (p.nbEvaluations === 0) pm.expect(p.moyenneGenerale).to.equal(null);",
                  "    p.historique.forEach(h => pm.expect(h.noteSur20).to.be.within(0, 20));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
