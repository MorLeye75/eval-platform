            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Réseaux — QCM\",\n  \"description\": \"Contrôle de réseaux\",\n  \"dureeStandard\": 60,\n  \"dateOuverture\": \"2026-11-10T08:00:00\",\n  \"dateFermeture\": \"2026-11-10T12:00:00\",\n  \"promotionIds\": [\n    1\n  ],\n  \"questions\": [\n    {\n      \"type\": \"QCM\",\n      \"enonce\": \"Quel protocole assure la livraison fiable ?\",\n      \"points\": 2,\n      \"estChoixMultiple\": false,\n      \"choix\": [\n        {\n          \"texte\": \"TCP\",\n          \"estCorrect\": true\n        },\n        {\n          \"texte\": \"UDP\",\n          \"estCorrect\": false\n        }\n      ]\n    },\n    {\n      \"type\": \"QUIZ_CHRONOMETREE\",\n      \"enonce\": \"Port HTTPS ?\",\n      \"points\": 1,\n      \"estChoixMultiple\": false,\n      \"dureeQuestion\": 20,\n      \"choix\": [\n        {\n          \"texte\": \"443\",\n          \"estCorrect\": true\n        },\n        {\n          \"texte\": \"80\",\n          \"estCorrect\": false\n        }\n      ]\n    },\n    {\n      \"type\": \"CODE\",\n      \"enonce\": \"Écrire fib(n)\",\n      \"points\": 5,\n      \"casTests\": [\n        {\n          \"entree\": \"5\",\n          \"sortieAttendue\": \"5\",\n          \"estMasque\": false\n        },\n        {\n          \"entree\": \"10\",\n          \"sortieAttendue\": \"55\",\n          \"estMasque\": true\n        }\n      ]\n    },\n    {\n      \"type\": \"OUVERTE\",\n      \"enonce\": \"Expliquez le routage\",\n      \"points\": 4\n    }\n  ]\n}"
            }
