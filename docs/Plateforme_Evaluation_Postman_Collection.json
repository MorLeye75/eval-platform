{
  "info": {
    "name": "Plateforme d'Évaluation EPT — API Collection",
    "_postman_id": "c1f7b889-8d54-4362-9e90-eval-ept-2026",
    "description": "Collection complète pour tester les endpoints de la Plateforme d'Évaluation EPT (DIC1-GIT).\nInclut l'authentification JWT automatique et les deux diagrammes de séquence (DS-01 et DS-02).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "soumissionId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "evaluationId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Authentification",
      "description": "Connexion des différents rôles avec récupération automatique du Bearer Token JWT.",
      "item": [
        {
          "name": "1.1 Login Étudiant (Aminou Niang)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token JWT étudiant enregistré avec succès.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"etudiant@ept.sn\",\n  \"motDePasse\": \"etudiant123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login Enseignant (Mamadou Sow)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token JWT enseignant enregistré.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prof@ept.sn\",\n  \"motDePasse\": \"prof123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Login Administrateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token JWT admin enregistré.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ept.sn\",\n  \"motDePasse\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Passation & Soumission (Vos Diagrammes DS-01 et DS-02)",
      "description": "Endpoints de gestion d'une copie d'examen, de l'auto-save toutes les 30s et de la soumission finale.",
      "item": [
        {
          "name": "2.1 Démarrer ou Reprendre l'épreuve",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('soumissionId', jsonData.id);",
                  "    console.log('Soumission ID enregistrée: ' + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/soumissions/evaluations/{{evaluationId}}/demarrer",
              "host": ["{{baseUrl}}"],
              "path": ["soumissions", "evaluations", "{{evaluationId}}", "demarrer"]
            }
          }
        },
        {
          "name": "2.2 Consulter le Sujet et l'état de la Copie",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["soumissions", "{{soumissionId}}"]
            }
          }
        },
        {
          "name": "2.3 DS-02: Auto-save des Réponses (toutes les 30s)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reponses\": [\n    {\n      \"questionId\": 1,\n      \"choixIds\": [2]\n    },\n    {\n      \"questionId\": 2,\n      \"choixIds\": [5, 7, 8]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}/sauvegarder",
              "host": ["{{baseUrl}}"],
              "path": ["soumissions", "{{soumissionId}}", "sauvegarder"]
            }
          }
        },
        {
          "name": "2.4 Anti-Triche: Signaler Changement d'Onglet",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}/changement-onglet",
              "host": ["{{baseUrl}}"],
              "path": ["soumissions", "{{soumissionId}}", "changement-onglet"]
            }
          }
        },
        {
          "name": "2.5 DS-01: Soumission Finale de la Copie",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/soumissions/{{soumissionId}}/soumettre",
              "host": ["{{baseUrl}}"],
              "path": ["soumissions", "{{soumissionId}}", "soumettre"]
            }
          }
        }
      ]
    }
  ]
}
