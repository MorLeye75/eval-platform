@startuml DS-10_demarrage_simplifie
title DS-10 — Démarrer ou reprendre une épreuve (vue simplifiée)
autonumber
actor "Étudiant" as E
boundary "Frontend React" as F
control "Backend Spring" as B
entity "BDD" as D

E -> F : ouvre "Mes évaluations"
F -> B ++ : GET /api/etudiant/evaluations
B -> D : évaluations de sa promotion + état de ses copies
B --> F -- : 200 OK (liste)
F --> E : affiche la liste

E -> F : clique sur "Commencer"
F -> B ++ : POST /api/soumissions/evaluations/{id}/demarrer
B -> D : évaluation, inscription, copie existante (sous verrou)

alt [refus : inconnue, non inscrit, non ouverte]
  B --> F : 404 / 403 / 400
  F --> E : message d'erreur
else [copie expirée ou déjà remise]
  B -> D : clôture si expirée
  B --> F : 200 OK { statut remis }
  F --> E : "Votre copie a déjà été remise"
else [nouvelle copie ou reprise dans les délais]
  B -> D : création ou reprise, questions, réponses, temps restant
  B --> F -- : 200 OK { questions, réponses, temps restant }
  F --> E : affiche l'épreuve et le chrono
end
@enduml
